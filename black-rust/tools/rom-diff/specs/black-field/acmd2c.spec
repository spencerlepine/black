# returns 1. The callers pass the ROM speed tables 0x021D4A68 (6 frames: 0x2000 0x3000 0x3000 0x2000 0x3000 0x3000), 0x021D4A44 (3: 0x5000
# 0x6000 0x5000), 0x021D4A80 (7: 0x2500, 0x2480 x6), 0x021D4A9C (12: 0x1000 0x1000 0x2000 x4); the index is not checked (bounded here to
# 0..2, which every table has).
fn 02198c4c ret=u32 inputs=200
  nowork
  arg buf 0x100
  arg u32 oneof 0x021D4A68 0x021D4A44 0x021D4A80 0x021D4A9C
  fix arg0 0xB4 u16 range 0 3
  fix arg0 0xB8 s16 alt range 0 12 || any
  fix arg0 0xBA s16 range 0 2
  stub 02163f10 force ret=none args=v  # mmdl_move: old grid = grid (m)
  stub 02163fc0 force ret=none args=v,v,v  # mmdl_move: position += n in dir (m, dir, n)
  stub 02164010 force ret=pick:0/1 args=v  # mmdl_move: put on the map height (m); result unused
  stub 0216d568 force ret=none args=v,v  # fldmmdl: move bits |= v (m, v)
  stub 0216d674 force ret=none args=v,v  # fldmmdl: u16 +0x2A = v (draw animation code; m, v)
  stub 0216d6d4 force ret=ptr:arg0:0xB4:1 args=v  # fldmmdl: acmd work m + 0xB4 (m)
  stub 0216d7cc force ret=none args=v  # fldmmdl: acmd seq + 1 (m)

