FROM --platform=linux/amd64 debian:bookworm-slim

# Dependencies from INSTALL.md (Debian/Ubuntu). The CodeWarrior tools are
# 32-bit Windows binaries, so wine32 is required.
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential autoconf automake python3 wine wine32 \
    binutils-arm-none-eabi git unzip ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /pokeblack
CMD ["make"]
